+// @vitest-environment jsdom
+import React from 'react';
+import { act, cleanup, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { MemoryRouter, useLocation } from 'react-router-dom';
+import type { SiteBindings } from '../desktop-host/runtime';
+
+const mocks = vi.hoisted(() => ({
+  mount: vi.fn(), unmount: vi.fn(), post: vi.fn(), subscribe: vi.fn(), validate: vi.fn(), logout: vi.fn(),
+  state: { isAuthenticated: true, sessionEnding: false, agent: { id: 7, permissions: ['complaint_records'] }, sessionRef: 'session-a' },
+}));
+vi.mock('../desktop-host/runtime', () => ({ mountDesktopHost: mocks.mount }));
+vi.mock('../services/apiClient', () => ({ default: { post: mocks.post } }));
+vi.mock('../stores/authStore', () => ({ useAuthStore: { getState: () => ({ ...mocks.state, refreshAgent: mocks.validate, logout: mocks.logout }), subscribe: mocks.subscribe } }));
+import DesktopHostPage from './DesktopHostPage';
+
+function LocationProbe() {
+  const location = useLocation();
+  return <output data-testid="location">{JSON.stringify({ pathname: location.pathname, state: location.state })}</output>;
+}
+describe('DesktopHostPage existing site bindings', () => {
+  let bindings: SiteBindings;
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.state.isAuthenticated = true; mocks.state.sessionEnding = false;
+    mocks.mount.mockImplementation((_root, value) => { bindings = value; return mocks.unmount; });
+    mocks.post.mockResolvedValue({ data: { success: true, data: 'allowed' } });
+    mocks.validate.mockResolvedValue({ id: 7 }); mocks.logout.mockResolvedValue(true);
+    render(<MemoryRouter initialEntries={['/desktop-host']}><DesktopHostPage /><LocationProbe /></MemoryRouter>);
+  });
+  afterEach(cleanup);
+  it('routes login back to the controlled host without exporting credentials', () => {
+    act(() => bindings.navigateLogin());
+    expect(JSON.parse(screen.getByTestId('location').textContent || '{}')).toEqual({ pathname: '/login', state: { returnTo: { pathname: '/desktop-host', search: '', hash: '' } } });
+    expect(bindings.session()).toEqual({ authenticated: true, accountScope: 'psim:7', sessionRef: 'session-a', permissions: ['complaint_records'] });
+  });
+  it('passes cancellation through the existing authenticated API client', async () => {
+    const controller = new AbortController(); const body = { text: 'safe fixture' };
+    await expect(bindings.post('/agent/translate', body, controller.signal)).resolves.toEqual({ success: true, data: 'allowed' });
+    expect(mocks.post).toHaveBeenCalledWith('/agent/translate', body, { signal: controller.signal });
+    await bindings.validate(); expect(mocks.validate).toHaveBeenCalledOnce();
+    await bindings.logout(); expect(mocks.logout).toHaveBeenCalledOnce();
+  });
+  it('keeps query deployment disabled and ends authentication while logout is pending', () => {
+    expect(bindings.operatorReadOnlyVerified).toBe(false);
+    mocks.state.sessionEnding = true;
+    expect(bindings.session().authenticated).toBe(false);
+  });
+  it('cleans up the host runtime on unmount', () => {
+    cleanup(); expect(mocks.unmount).toHaveBeenCalledOnce();
+  });
+});
