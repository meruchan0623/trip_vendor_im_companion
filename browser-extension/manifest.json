{
  "manifest_version":3,
  "name":"TSim 旅游商家助手会话桥",
  "version":"1.0.0",
  "description":"在已登录的 TSim 页面内部执行身份核验与翻译；不导出登录令牌，不发送客户消息。",
  "key":"",
  "permissions":["scripting","tabs","nativeMessaging","alarms"],
  "host_permissions":["https://csagent.tsim.tech/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_title":"连接 TSim 旅游商家助手","default_popup":"status.html"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; frame-src https://csagent.tsim.tech"}
}
